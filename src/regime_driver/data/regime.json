{
  "version": "0.1",
  "description": "Compiled institutional process (code-workflow). Nodes declare a role (which user-registered session owns it) and a type (agent=work, judge=judgement). Roles developer/reviewer are user-specialized instances; the kernel is role-agnostic.",
  "meta": {
    "source": [
      "workflow-regime/task-control/07_goal_mechanism.md",
      "workflow-regime/task-control/08_autonomous_loop.md",
      "workflow-regime/skills/code-workflow/SKILL.md"
    ],
    "session_turn_check": 5,
    "work_done_marker": "[WORK_DONE]"
  },
  "flows": {
    "code_workflow": {
      "nodes": {
        "understand": {
          "id": "understand",
          "desc": "理解任务上下文",
          "role": "developer",
          "type": "agent",
          "readonly": true,
          "next": "read_code"
        },
        "read_code": {
          "id": "read_code",
          "desc": "理解代码上下文",
          "role": "developer",
          "type": "agent",
          "readonly": true,
          "next": "design"
        },
        "design": {
          "id": "design",
          "desc": "方案设计",
          "role": "reviewer",
          "type": "judge",
          "skill": "design-philosophy",
          "next": "implement"
        },
        "implement": {
          "id": "implement",
          "desc": "实现",
          "role": "developer",
          "type": "agent",
          "skill": "developer-quality",
          "next": "test"
        },
        "test": {
          "id": "test",
          "desc": "测试与验证",
          "role": "reviewer",
          "type": "judge",
          "skill": "code-review",
          "next": "wrap"
        },
        "wrap": {
          "id": "wrap",
          "desc": "收尾与清理",
          "role": "developer",
          "type": "agent",
          "skill": "developer-quality",
          "next": null
        }
      }
    }
  },
  "entry": {
    "flow": "code_workflow",
    "start_node": "understand"
  }
}