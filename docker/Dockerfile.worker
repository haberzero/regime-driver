# regime-driver M-1: opencode-worker 镜像
# 基座: opencode-mvp:1.18.11 (Ubuntu 24.04 + Node 22 + opencode-ai@1.18.11 + py3.12 + git + curl)
# 叠加: miniconda (python + 项目依赖) + 无插件 opencode 配置 (developer/reviewer agent)
ARG BASE=opencode-mvp:1.18.11
FROM ${BASE}

ENV OPENCODE_PORT=4097 \
    MINICONDA_DIR=/opt/miniconda3 \
    PATH=/opt/miniconda3/bin:/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# 用清华镜像安装 miniconda (Docker Hub 下载源被墙)
RUN curl -fsSL -o /tmp/miniconda.sh \
    https://mirrors.tuna.tsinghua.edu.cn/anaconda/miniconda/Miniconda3-latest-Linux-x86_64.sh \
  && bash /tmp/miniconda.sh -b -p /opt/miniconda3 \
  && rm -f /tmp/miniconda.sh \
  && /opt/miniconda3/bin/conda config --set auto_activate_base false \
  && printf 'channels:\n  - conda-forge\nchannel_priority: strict\n' > /root/.condarc \
  && /opt/miniconda3/bin/conda clean -afy

# 无插件 opencode 配置 (可提交, 无密钥)
# opencode.json 是模板: apiKey 用 {env:DEEPSEEK_API_KEY} 占位, 运行时经环境变量注入
#   docker run -e DEEPSEEK_API_KEY=<key> ...
# 镜像内置 developer(default) 与 reviewer(只读) 两个 agent; 无插件、无密钥
COPY docker/worker-config/opencode.json /root/.config/opencode/opencode.json
COPY docker/worker-config/agents/reviewer.md /root/.config/opencode/agents/reviewer.md

WORKDIR /root/work

# 头less 服务方式提供 API (端口 4097), --pure 强制无插件
ENTRYPOINT ["/bin/sh","-c","exec opencode serve --pure --hostname 0.0.0.0 --port ${OPENCODE_PORT:-4097} \"$@\" --"]